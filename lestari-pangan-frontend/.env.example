# Salin menjadi .env.local (tidak ikut git), lalu isi dari Supabase Dashboard → Project Settings → API.
# Semua VITE_* tertanam di bundle browser: HANYA URL proyek dan publishable key.
# Jangan pernah menaruh service role / secret key di sini (build akan gagal, lihat config/publicEnvGuard.ts).
# Keduanya wajib; tanpa env aplikasi menampilkan layar "Konfigurasi belum lengkap". Mode demo tanpa backend ada di folder prototype/.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
