# Dependensi dan hasil build (semua sub-proyek)
node_modules/
dist/
dist-ssr/
dist-static/
*.log

# Env lokal: hanya .env.example yang boleh di-commit
.env
.env.*
!.env.example

# Konfigurasi lokal Vercel CLI dan alat bantu lokal
.vercel/
.playwright-cli/


# Ekspor desain Stitch dan arsip (68 MB, bukan kode sumber)
output/

# Cadangan riwayat git lama front end
.backup-frontend-git/

.DS_Store

# Paket Android (APK/AAB) dan kunci tanda tangan: kunci TIDAK BOLEH masuk git
android-release/
*.keystore
*.jks

# Hasil mentah ChatGPT (PNG besar); hanya versi WebP jadi yang di-commit
assets/_mentah/

# Repo publik hanya berisi kode aplikasi + dokumen untuk juri.
